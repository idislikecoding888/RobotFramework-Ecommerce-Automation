SELENATOR_HOST=127.0.0.1
SELENATOR_PORT=8787
SELENATOR_PROJECT_ROOT=..
SELENATOR_DEFAULT_TARGET_URL=https://automationexercise.com
SELENATOR_BROWSER=chrome
SELENATOR_PYTHON_COMMAND=python
SELENATOR_FRONTEND_ORIGIN=http://localhost:3000
